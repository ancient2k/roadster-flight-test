{
  "name": "roadster-flight-test",
  "private": true,
  "version": "1.0.0",
  "description": "Unofficial browser simulation of the Tesla Roadster Gen 2 prototype: cold-gas thrusters, fan suction, stunts and ten worlds (WebGPU, Rapier).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "package": "bash tools/package-web.sh"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
